{
  "version": "v1",
  "transport": {
    "host": "0.0.0.0",
    "port": 8765
  },
  "decision_timeout_ms": 120000,
  "fallback_mode": "safe_continue",
  "logging": {
    "events": true,
    "prompts": true,
    "raw_provider_payloads": true
  },
  "policy_mapping": {
    "p1": "rl/self-play-p1",
    "p2": "rl/self-play-p2"
  },
  "policies": {
    "rl/self-play-p1": {
      "provider": "openrouter",
      "model": "PLACEHOLDER_SAMPLER_PATH",
      "prompt_version": "strategic_rl_v1",
      "credential_env_var": "TINKER_API_KEY",
      "temperature": 0.9,
      "max_tokens": 256,
      "options": {
        "base_url": "https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1",
        "response_parser": {
          "enable_correction_retry": true,
          "max_correction_retries": 1
        }
      }
    },
    "rl/self-play-p2": {
      "provider": "openrouter",
      "model": "PLACEHOLDER_SAMPLER_PATH",
      "prompt_version": "strategic_rl_v1",
      "credential_env_var": "TINKER_API_KEY",
      "temperature": 0.9,
      "max_tokens": 256,
      "options": {
        "base_url": "https://tinker.thinkingmachines.dev/services/tinker-prod/oai/api/v1",
        "response_parser": {
          "enable_correction_retry": true,
          "max_correction_retries": 1
        }
      }
    }
  },
  "character_selection": {
    "mode": "assigned",
    "assignments": {
      "p1": "Cowboy",
      "p2": "Cowboy"
    }
  },
  "trace_seed": 0,
  "stage_id": "training_room",
  "match_options": {
    "starting_hp": 750
  }
}
